GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_CONDUCT_MODEL=gemini-3.6-flash
AI_CONDUCT_MONITORING=true
PORT=3000

# Persistent production storage. On Render, point this at a mounted persistent disk.
DATA_DIR=

# Required in production for student/teacher verification, password recovery, and certificate email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
# Gmail: use a Google App Password here, not the normal Gmail account password.
CERT_FROM_NAME=iSpeak Confidence
BOOKING_TO=ispeakconfidence@gmail.com


# Legacy shared admin PIN (leave disabled for production).
# ADMIN_PORTAL_PIN=

# Production WebRTC TURN relay. Strongly recommended so camera/mic work across mobile carriers, strict NAT and firewalls.
# Comma-separate multiple endpoints (UDP/TCP/TLS), e.g. turn:host:80,turn:host:80?transport=tcp,turns:host:443?transport=tcp
TURN_URLS=
# Backward-compatible single endpoint (used only when TURN_URLS is empty)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# V18.8.20 production hardening
# Production must have DATABASE_URL or a persistent DATA_DIR.
# ALLOW_EPHEMERAL_PRODUCTION=true is for disposable testing only and should not be used for real users.
ALLOW_EPHEMERAL_PRODUCTION=false
# Shared admin PIN is disabled by default. Keep this false in production.
ALLOW_LEGACY_ADMIN_PIN=false
# Required if teachers should send the manual Revolut payment link from the portal.
ISPEAK_MANUAL_PAYMENT_LINK=
# Gemini resilience controls.
GEMINI_TIMEOUT_MS=18000
GEMINI_RETRIES=2

# Revolut Merchant API integration
REVOLUT_API_VERSION=2026-03-12
REVOLUT_SECRET_API_KEY=
REVOLUT_WEBHOOK_SIGNING_SECRET=

# Nathan owner login (keep the code ONLY in Render Environment; never commit the real code)
NATHAN_OWNER_EMAIL=nathandamian712@gmail.com
NATHAN_OWNER_LOGIN_CODE=
