GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_CONDUCT_MODEL=gemini-2.5-flash
AI_CONDUCT_MONITORING=true
PORT=3000

# Persistent production storage. On Render, point this at a mounted persistent disk.
DATA_DIR=

# Optional: required for direct tutor-request and certificate email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
CERT_FROM_NAME=iSpeak Confidence
BOOKING_TO=ispeakconfidence@gmail.com


# Teacher application admin review
ADMIN_PORTAL_PIN=change-me-before-production

# Optional production WebRTC relay for restrictive networks
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
